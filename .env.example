# =============================================================================
# Claude Orchestrator - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://claude:claude@postgres:5432/orchestrator
POSTGRES_USER=claude
POSTGRES_PASSWORD=claude
POSTGRES_DB=orchestrator

# -----------------------------------------------------------------------------
# Redis (Queue / Cache / Pub-Sub)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Cloudflare Tunnel & Access
# -----------------------------------------------------------------------------
# Tunnel token from: cloudflared tunnel create orchestrator
CLOUDFLARE_TUNNEL_TOKEN=

# Your Cloudflare Zero Trust team domain (e.g., myteam.cloudflareaccess.com)
CF_TEAM_DOMAIN=

# Application Audience (AUD) tag from Cloudflare Access application settings
CF_ACCESS_AUD=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Set to true to skip Cloudflare Access JWT validation (local dev only)
# WARNING: When true, ensure the app only binds to 127.0.0.1
AUTH_BYPASS=false

# -----------------------------------------------------------------------------
# Claude Code Defaults
# -----------------------------------------------------------------------------
DEFAULT_MODEL=claude-sonnet-4-20250514
DEFAULT_MAX_TURNS=10

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://orchestrator.yourdomain.com,http://localhost:5173

# Backend host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
